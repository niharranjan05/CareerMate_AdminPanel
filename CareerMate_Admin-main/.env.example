# Copy to .env (locally) or set these in Render's Environment tab.

# Your FastAPI bot backend's public URL — NO trailing slash.
BACKEND_URL=https://your-backend.onrender.com

# Signs the Flask session cookie. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_this_with_a_long_random_string

# development | production
FLASK_ENV=development

# Optional overrides
PORT=5000
SESSION_HOURS=24
BACKEND_TIMEOUT=15

# NOTE: DEFAULT_ADMIN_USER / DEFAULT_ADMIN_PASS are NOT set here.
# Those live only on the backend (Render) — this panel never stores
# credentials itself, it just logs in against the backend's real
# auth.py-based admin account.
